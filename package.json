{
  "name": "mac-explorer",
  "version": "1.8.0",
  "private": true,
  "description": "A Windows 11-style file explorer for macOS",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:compression": "npm run build && node scripts/compression-smoke.mjs",
    "test:archive": "npm run build && node scripts/archive-smoke.mjs && node scripts/extraction-smoke.mjs",
    "test:ui": "npm run build && node scripts/smoke.mjs",
    "test:window-state": "npm run build && node scripts/window-state-smoke.mjs && node scripts/window-quit-smoke.mjs",
    "test:theme": "npm run build && node scripts/theme-smoke.mjs",
    "test:view": "npm run build && node scripts/view-menu-smoke.mjs",
    "test:icons": "npm run build && node scripts/icon-address-smoke.mjs",
    "test:drives": "npm run build && node scripts/drive-card-smoke.mjs",
    "package": "node scripts/make-icon.mjs && npm run build && electron-builder --mac dir --arm64 && codesign --force --deep --sign - 'release/mac-arm64/Mac Explorer.app'",
    "test:external": "npm run build && node scripts/external-open-smoke.mjs",
    "package:release": "node scripts/make-icon.mjs && npm run build && node scripts/release.mjs",
    "test:text-edit": "npm run build && node scripts/text-edit-smoke.mjs",
    "test:shortcuts": "npm run build && node scripts/finder-shortcuts-smoke.mjs",
    "test:cut": "npm run build && node scripts/cut-shortcut-smoke.mjs",
    "test:clipboard": "npm run build && node scripts/clipboard-smoke.mjs",
    "test:properties": "npm run build && node scripts/properties-smoke.mjs",
    "test:swipe": "npm run build && node scripts/swipe-navigation-smoke.mjs",
    "test:startup": "npm run build && node scripts/startup-smoke.mjs",
    "test:selection": "npm run build && node scripts/marquee-smoke.mjs",
    "test:document-icons": "npm run build && node scripts/document-icons-smoke.mjs",
    "test:motion": "npm run build && node scripts/motion-smoke.mjs",
    "test:trash-confirmation": "npm run build && node scripts/trash-confirmation-smoke.mjs",
    "test:trash-native": "npm run build && node scripts/trash-native-smoke.mjs",
    "test:applications-address": "npm run build && node scripts/applications-address-smoke.mjs",
    "test:office-thumbnails": "npm run build && node scripts/office-thumbnails-smoke.mjs",
    "test:thumbnail-cache": "npm run build && node scripts/thumbnail-cache-smoke.mjs",
    "test:tabs": "npm run build && node scripts/tab-detach-smoke.mjs",
    "test:language": "npm run build && node scripts/language-smoke.mjs",
    "test:eject": "npm run build && node scripts/eject-smoke.mjs",
    "test:connections": "npm run build && node scripts/connections-smoke.mjs",
    "test:trash-browser": "npm run build && node scripts/trash-browser-smoke.mjs && node scripts/trash-operations-smoke.mjs",
    "test:dock": "npm run build && node scripts/dock-menu-smoke.mjs",
    "test:file-drag": "npm run build && node scripts/file-drag-smoke.mjs",
    "test:drop-move": "npm run build && node scripts/drop-move-smoke.mjs",
    "test:mouse-navigation": "npm run build && node scripts/mouse-navigation-smoke.mjs",
    "test:quick-access": "npm run build && node scripts/quick-access-order-smoke.mjs",
    "test:settings": "npm run build && node scripts/settings-smoke.mjs",
    "test:settings-window": "npm run build && node scripts/settings-window-smoke.mjs",
    "test:vcs": "npm run build && node scripts/vcs-smoke.mjs",
    "test:terminal": "npm run build && node scripts/default-terminal-smoke.mjs",
    "test:toolbar": "npm run build && node scripts/toolbar-smoke.mjs",
    "test:new": "npm run build && node scripts/new-entry-smoke.mjs",
    "test:share": "npm run build && node scripts/share-menu-smoke.mjs",
    "test:operation-shortcuts": "npm run build && node scripts/operation-shortcuts-smoke.mjs",
    "test:numbered-shortcuts": "npm run build && node scripts/numbered-shortcuts-smoke.mjs",
    "test:file-viewer": "npm run build && node scripts/file-viewer-smoke.mjs",
    "test:updates": "npm run build && node scripts/about-update-smoke.mjs",
    "test:updater-asar": "npm run build && node scripts/updater-asar-smoke.mjs",
    "test:folder-view": "npm run build && node scripts/folder-view-smoke.mjs && node scripts/folder-view-sync-smoke.mjs",
    "test:address-bar": "npm run build && node scripts/address-bar-smoke.mjs && node scripts/address-bar-regression-smoke.mjs",
    "test:text-input-shortcuts": "npm run build && node scripts/text-input-shortcuts-smoke.mjs",
    "test:finder-favorites": "npm run build && node scripts/finder-favorites-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "node-api-headers": "^1.9.0",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.macexplorer.desktop",
    "productName": "Mac Explorer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/native/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "发现并连接局域网中的共享电脑和文件服务器。",
        "NSBonjourServices": [
          "_smb._tcp"
        ],
        "NSDesktopFolderUsageDescription": "浏览和管理桌面中的文件。",
        "NSDocumentsFolderUsageDescription": "浏览和管理文稿中的文件。",
        "NSDownloadsFolderUsageDescription": "浏览和管理下载中的文件。",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Files and Folders",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.data",
              "public.folder",
              "public.volume",
              "public.text",
              "public.image",
              "public.audio",
              "public.movie",
              "public.archive",
              "com.adobe.pdf",
              "com.apple.package"
            ]
          }
        ]
      },
      "minimumSystemVersion": "13.0"
    }
  },
  "license": "GPL-3.0-only",
  "author": "qixiaoyu27"
}
